---
// English academic CV.
import Base from '../layouts/Base.astro';
import CvHeader from '../components/CvHeader.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import Authors from '../components/Authors.astro';
import Skills from '../components/Skills.astro';
import Tags from '../components/Tags.astro';
import { f, clean, range, tagsOf, getProfile, getEducation, getExperience, getProjects, getPublications, getAwards, getCertificates, getSkillGroups } from '../lib/content';

const aud = 'academic';
const lang = 'en';
const profile = await getProfile();
const [edu, exp, projects, pubs, awards, certs, groups] = await Promise.all([
  getEducation(aud), getExperience(aud), getProjects(aud), getPublications(aud),
  getAwards(aud), getCertificates(aud), getSkillGroups(aud),
]);
const about = clean(profile.about_en).split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean);
const statement = clean(profile.research_statement_en);
const AI_GROUP = 'acad-ai-workflow';
const aiGroup = groups.find((g) => g.id === AI_GROUP);
const skillGroups = groups.filter((g) => g.id !== AI_GROUP);
// Experience entries at one organization: say it once under the heading.
const orgs = [...new Set(exp.map((e) => f(e, 'organization', lang)))];
const sharedOrg = orgs.length === 1 ? orgs[0] : '';
---
<Base title={`${profile.name} – Academic CV`} description={clean(profile.summary_en)} lang="en" pdf={profile.cv_pdf.academic ?? undefined}>
  <CvHeader profile={profile} audience={aud} />

  <Section title="Summary">
    <p>{clean(profile.summary_en)}</p>
    {about.map((p) => <p>{p}</p>)}
  </Section>

  <Section title="Education">
    {edu.map((e) => {
      const degree = f(e, 'degree_title', lang);
      const program = f(e, 'program', lang);
      const former = f(e, 'former_name', lang);
      const note = f(e, 'note', lang);
      const gpa = e.gpa != null ? `GPA ${e.gpa.toFixed(2)}/${(e.gpa_scale ?? 4).toFixed(2)}` : '';
      const detail = [e.cohort ? `Cohort ${e.cohort}` : '', gpa].filter(Boolean).join(' · ');
      return (
        <Entry
          title={f(e, 'institution', lang, true)}
          when={range(e.start, e.end, lang, 'in progress')}
          sub={[degree, program].filter(Boolean).join(', ')}
          where={detail || (former ? '' : note)}
        >
          {former && <ul><li>Formerly {former}.</li></ul>}
        </Entry>
      );
    })}
  </Section>

  <Section title="Research interests">
    <ul class="inline-list">{profile.research_interests_en.map((r) => <li>{r}</li>)}</ul>
    {statement && <p class="statement">{statement}</p>}
  </Section>

  {exp.length > 0 && (
    <Section title="Research experience">
      {sharedOrg && <p class="meta role">{sharedOrg}</p>}
      {exp.map((e) => (
        <Entry
          title={f(e, 'role', lang)}
          when={range(e.start, e.end, lang, e.ongoing ? 'ongoing' : undefined)}
          sub={sharedOrg ? '' : f(e, 'organization', lang)}
          where={e.advisor && !sharedOrg ? `Advisor: ${e.advisor}` : undefined}
          extra={e.advisor && sharedOrg ? `(Advisor: ${e.advisor})` : undefined}
        >
          {e.bullets_en.length > 0 && <ul>{e.bullets_en.map((b) => <li>{b}</li>)}</ul>}
        </Entry>
      ))}
    </Section>
  )}

  <Section title="Publications">
    {pubs.map((p) => (
      <Entry id={`pub-${p.id}`} title={p.title} when={String(p.year)}>
        <p class="pub"><Authors authors={p.authors} /> · <em>{f(p, 'venue', lang)}</em>{p.authors.some((a) => a.is_corresponding) && <span class="x"> (* corresponding author)</span>}{p.links.map((l) => <> · <a href={l.url}>{f(l, 'label', lang)}</a></>)}</p>
      </Entry>
    ))}
  </Section>

  <Section title="Projects">
    {projects.map((p) => {
      const link = p.links[0];
      // A research project that is also a manuscript is listed in Publications and detailed on /nghien-cuu: title + status line only here.
      const brief = p.kind === 'research';
      const when = range(p.start ?? '', p.end, lang) || f(p, 'status_note', lang);
      return (
        <Entry title={p.title} when={when} sub={f(p, 'tagline', lang)} where={p.advisor ? `Advisor: ${p.advisor}` : undefined} href={link?.url}>
          {!brief && <Tags tags={tagsOf(p, lang)} />}
          {!brief && p.highlights_en.length > 0 && <ul>{p.highlights_en.map((h) => <li>{h}</li>)}</ul>}
        </Entry>
      );
    })}
  </Section>

  {awards.length > 0 && (
    <Section title="Honors and awards">
      {awards.map((a) => (
        <Entry title={f(a, 'title', lang)} extra={`· ${f(a, 'issuer', lang)}`} when={a.date_label} />
      ))}
    </Section>
  )}

  <Section title="Technical skills">
    <Skills groups={skillGroups} lang={lang} />
  </Section>

  {aiGroup && (
    <Section title={f(aiGroup, 'title', lang)}>
      <ul>{aiGroup.skills.map((s) => <li>{f(s, 'name', lang)}</li>)}</ul>
    </Section>
  )}

  <Section title="Languages">
    <ul class="inline-list">
      {certs.map((c) => <li>{f(c, 'name', lang)}</li>)}
      <li>{clean(profile.native_language_en)}</li>
    </ul>
  </Section>
</Base>
