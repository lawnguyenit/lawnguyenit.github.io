---
// Research detail (Vietnamese). Text falls back to English where no Vietnamese text exists.
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import Authors from '../components/Authors.astro';
import Tags from '../components/Tags.astro';
import { clean, f, range, tagsOf, viOrEn, PROJECT_STATUS_VI, getProfile, getResearchProjects, getResearchPublications, advisorName } from '../lib/content';

const profile = await getProfile();
const projects = await getResearchProjects();
const pubs = await getResearchPublications();
const statement = clean(profile.research_statement_en);
const interests = profile.research_interests_en;
---
<Base title={`Nghiên cứu – ${profile.name_native}`} description="Các hướng nghiên cứu, dự án và công bố: ML đáng tin cậy cho IoT nông nghiệp, nhãn yếu, đánh giá theo thời gian." lang="vi" pdf="/pdf/ho-so-di-lam.pdf">
  <header class="cv-head">
    <h1 class="name">Nghiên cứu</h1>
    <p class="role">{profile.name_native}</p>
  </header>

  <Section title="Hướng nghiên cứu">
    <ul class="inline-list">{interests.map((r) => <li lang="en">{r}</li>)}</ul>
    {statement && <p lang="en">{statement}</p>}
  </Section>

  <Section title="Dự án nghiên cứu">
    {projects.map((p) => {
      const summary = viOrEn(p, 'summary');
      const contrib = viOrEn(p, 'contribution');
      const tag = viOrEn(p, 'tagline');
      const hl = p.highlights_vi.length > 0 ? { items: p.highlights_vi, lang: 'vi' } : { items: p.highlights_en, lang: 'en' };
      return (
        <Entry title={p.title} when={range(p.start ?? '', p.end, 'vi')} sub={PROJECT_STATUS_VI[p.status]} where={p.advisor ? `Hướng dẫn: ${advisorName(p.advisor, 'vi')}` : undefined} lang="en">
          <Tags tags={tagsOf(p, 'vi')} />
          {tag.text && <p lang={tag.lang}><em>{tag.text}</em></p>}
          {summary.text && <p lang={summary.lang}>{summary.text}</p>}
          {hl.items.length > 0 && <ul lang={hl.lang}>{hl.items.map((h) => <li>{h}</li>)}</ul>}
          {contrib.text && <p class="meta"><span lang={contrib.lang}>Vai trò: {contrib.text}</span></p>}
          {p.figures.map((fig) => (
            <figure>
              <img src={fig.src} alt={fig.alt_en} loading="lazy" />
              <figcaption lang={fig.caption_vi ? 'vi' : 'en'}>{fig.caption_vi || fig.caption_en}</figcaption>
            </figure>
          ))}
          <p class="meta">
            {p.tech.length > 0 && <span>Công nghệ: {p.tech.join(', ')}</span>}
            {p.links.map((l) => <span>{f(l, 'label', 'vi', true)}: <a href={l.url}>{l.url.replace(/^https?:\/\//, '')}</a></span>)}
          </p>
        </Entry>
      );
    })}
  </Section>

  <Section title="Công bố khoa học">
    {pubs.map((p) => {
      const venue = viOrEn(p, 'venue');
      const summary = viOrEn(p, 'summary');
      return (
        <Entry id={`pub-${p.id}`} title={p.title} when={String(p.year)} lang="en">
          <p class="pub"><Authors authors={p.authors} /></p>
          {venue.text && <p class="pub" lang={venue.lang}><em>{venue.text}</em></p>}
          {summary.text && <p lang={summary.lang}>{summary.text}</p>}
          {p.links.map((l) => <p class="pub"><a href={l.url}>{f(l, 'label', 'vi', true)}</a></p>)}
        </Entry>
      );
    })}
  </Section>
</Base>
